<Window x:Class="WoodCNC.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WoodCNC - 文件预览与轮廓来源"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="560"
        Background="#F5F7F8">
    <Window.Resources>
        <DrawingBrush x:Key="PreviewBackgroundBrush"
                      TileMode="Tile"
                      Viewport="0,0,20,20"
                      ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFFFFF">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,20,20" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#EEF2F5">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,10,10" />
                                <RectangleGeometry Rect="10,10,10,10" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#D7DDE2" BorderThickness="0,0,0,1">
            <Grid Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="OpenButton" MinWidth="88" Height="32" Content="打开" Click="OpenButton_Click" />
                    <Button x:Name="OpenDxfButton" MinWidth="88" Height="32" Margin="8,0,0,0" Content="打开DXF" Click="OpenDxfButton_Click" />
                    <Button x:Name="OpenImageButton" MinWidth="88" Height="32" Margin="8,0,0,0" Content="打开图片" Click="OpenImageButton_Click" />
                    <Button x:Name="PlayButton" MinWidth="72" Height="32" Margin="8,0,0,0" Content="播放" Click="PlayButton_Click" IsEnabled="False" />
                    <Button x:Name="StepButton" MinWidth="72" Height="32" Margin="8,0,0,0" Content="单步" Click="StepButton_Click" IsEnabled="False" />
                    <Button x:Name="ResetButton" MinWidth="72" Height="32" Margin="8,0,0,0" Content="重置" Click="ResetButton_Click" IsEnabled="False" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="ExportPlainButton" MinWidth="96" Height="32" Margin="0,0,8,0" Content="导出明文" Click="ExportPlainButton_Click" IsEnabled="False" />
                    <Button x:Name="ExportXorButton" MinWidth="96" Height="32" Content="导出XOR" Click="ExportXorButton_Click" IsEnabled="False" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="12" Background="#FFFFFF" BorderBrush="#D7DDE2" BorderThickness="1">
                <Grid>
                    <ScrollViewer x:Name="PreviewScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Canvas x:Name="PreviewCanvas" Width="760" Height="540" Background="{StaticResource PreviewBackgroundBrush}" MouseWheel="PreviewCanvas_MouseWheel" />
                    </ScrollViewer>
                    <Border HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="10"
                            Padding="6"
                            Background="#F8FAFB"
                            BorderBrush="#D7DDE2"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ZoomOutButton" Width="30" Height="28" Content="-" Click="ZoomOutButton_Click" IsEnabled="False" />
                            <TextBlock x:Name="ZoomText" Width="52" Margin="6,0" VerticalAlignment="Center" TextAlignment="Center" Text="100%" />
                            <Button x:Name="ZoomInButton" Width="30" Height="28" Content="+" Click="ZoomInButton_Click" IsEnabled="False" />
                            <Button x:Name="FitButton" Width="50" Height="28" Margin="8,0,0,0" Content="适配" Click="FitButton_Click" IsEnabled="False" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="0,12,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="160" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#D7DDE2" BorderThickness="1" Padding="10" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock x:Name="FileText" FontWeight="SemiBold" Text="未打开文件" TextWrapping="Wrap" />
                        <TextBlock x:Name="SummaryText" Margin="0,8,0,0" Foreground="#44515C" TextWrapping="Wrap" />
                        <TextBlock x:Name="TimeText" Margin="0,8,0,0" Foreground="#44515C" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#D7DDE2" BorderThickness="1" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="轮廓模板" />
                            <ComboBox x:Name="TemplateKindCombo" Height="30" Margin="0,8,0,0" SelectedIndex="0">
                                <ComboBoxItem Content="矩形" />
                                <ComboBoxItem Content="圆" />
                                <ComboBoxItem Content="椭圆" />
                                <ComboBoxItem Content="圆角矩形" />
                            </ComboBox>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="宽度/直径" Foreground="#44515C" />
                                    <TextBox x:Name="TemplateWidthText" Height="28" Text="80" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="高度" Foreground="#44515C" />
                                    <TextBox x:Name="TemplateHeightText" Height="28" Text="40" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="圆角半径" Foreground="#44515C" />
                                <TextBox x:Name="TemplateRadiusText" Height="28" Text="5" />
                            </StackPanel>
                            <Button Height="32" Margin="0,10,0,0" Content="生成轮廓" Click="GenerateTemplateButton_Click" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#D7DDE2" BorderThickness="1">
                        <ListBox x:Name="SegmentList" FontFamily="Consolas" FontSize="12" SelectionChanged="SegmentList_SelectionChanged" />
                    </Border>
                </Grid>

                <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#D7DDE2" BorderThickness="1">
                    <TextBox x:Name="DiagnosticText"
                             FontFamily="Consolas"
                             FontSize="12"
                             Padding="8"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>

